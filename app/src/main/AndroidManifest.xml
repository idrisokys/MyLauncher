<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Tüm dosyalara erişim: Notlarım (Link klasörü), Dosyalarım ve Galerim bu tek izni ortak kullanır -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" tools:replace="android:maxSdkVersion" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" tools:replace="android:maxSdkVersion" />

    <application
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="MyL"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Sohbet içinden "Ana ekrana ekle" denince sistem bu filtreyle varsayılan başlatıcıyı çağırır -->
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>
        <!-- Notlarım (eski adıyla LinkCepte). LAUNCHER girişi sayesinde ana ekran ızgarasında "Notlarım" simgesi olarak görünür;
             edit simgesine basılı tutunca da açılır. Kendi görevinde çalışır, Home ile launcher'ı etkilemez. -->
        <activity
            android:name=".NotesActivity"
            android:exported="true"
            android:label="Notlarım"
            android:icon="@mipmap/ic_notes"
            android:roundIcon="@mipmap/ic_notes"
            android:theme="@style/NotesTheme"
            android:launchMode="singleTask"
            android:taskAffinity="io.github.idrisokys.myl.notes"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Paylaş menüsünde "Notlarım": link ve metinler Store.submit ile kaydedilir (arayüzsüz) -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:label="Notlarım"
            android:icon="@mipmap/ic_notes"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/ShareTheme">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- Paylaş menüsünde "Duvar kağıdı yap": görseli ana ekran + kilit ekranı yapar (arayüzsüz) -->
        <activity
            android:name=".SetWallpaperActivity"
            android:exported="true"
            android:label="Duvar kağıdı yap"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.ATTACH_DATA" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <!-- Ayarlar > Duvar kağıdı: görseli ekran oranında kırpıp duvar kağıdı yapar -->
        <activity
            android:name=".CropWallpaperActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Black.NoTitleBar" />
        <!-- Dosyalarım: dosya yöneticisi bölümü. Notlarım gibi kendi görevinde çalışır ve ana ekran ızgarasında simge olarak görünür.
             Paylaş menüsünde de görünür: gelen dosyaları seçilen klasöre kaydeder. -->
        <activity
            android:name=".files.FilesActivity"
            android:exported="true"
            android:label="Dosyalarım"
            android:icon="@mipmap/ic_files"
            android:roundIcon="@mipmap/ic_files"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:launchMode="singleTask"
            android:taskAffinity="io.github.idrisokys.myl.files">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <!-- Galerim: resim/video galerisi bölümü (seçim modu, toplu silme, klasöre taşıma). Kendi görevinde çalışır. -->
        <activity
            android:name=".gallery.GalleryActivity"
            android:exported="true"
            android:label="Galerim"
            android:icon="@mipmap/ic_gallery"
            android:roundIcon="@mipmap/ic_gallery"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:launchMode="singleTask"
            android:taskAffinity="io.github.idrisokys.myl.gallery"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Galerim'deki sihirli değnekle açılan temel resim düzenleyicisi (basic-editor modülü).
             Aynı görevde (Galerim'in üstünde) açılır; geri okuyla Galerim'e dönülür. -->
        <activity
            android:name="org.fossify.editor.activities.EditActivity"
            android:exported="false"
            android:theme="@style/EditorTheme" />
        <!-- Düzenleyicinin Paylaş düğmesi için (commons: <applicationId>.provider) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>
        <!-- Dosyalarım ve Galerim'in ortak dosya sağlayıcısı (paylaşma / açma için) -->
        <provider
            android:name=".common.KFileProvider"
            android:authorities="${applicationId}.fp"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
