<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to read/write images on API <= 32. On newer APIs the host app requests
         READ_MEDIA_IMAGES (commons handles the prompt via handlePermission). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application>
        <!-- No intent-filters on purpose: launch it with EditActivity.newIntent(...).
             To also act as a system image editor, copy the EDIT / CROP filters from
             the original Gallery manifest into your own app manifest (see README). -->
        <activity
            android:name="org.fossify.editor.activities.EditActivity"
            android:configChanges="orientation"
            android:exported="false"
            android:label="@string/basic_editor" />
    </application>
</manifest>
